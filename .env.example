# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DB_NAME=servicedesk
DB_USER=servicedesk
DB_PASSWORD=change-me
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_PORT=9092

# --- Backend ---
SERVER_PORT=8080
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI provider: "mock" runs fully offline with no API key needed.
# Set to "anthropic" and provide ANTHROPIC_API_KEY to use a real LLM.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Remediation executor: "mock" simulates remediation actions safely for local/demo use.
REMEDIATION_EXECUTOR=mock

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
